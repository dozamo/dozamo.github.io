{{- $index := slice -}}
{{- range .Site.RegularPages -}}
  {{- if not .Params.exclude_search -}}
    {{- $index = $index | append (dict
      "id" .File.UniqueID
      "title" .Title
      "content" (.Plain | htmlUnescape)
      "url" .Permalink
      "tags" .Params.tags
      "categories" .Params.categories
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
