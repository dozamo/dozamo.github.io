# ./hugo.yaml
baseURL: "https://dozamo.github.io/"
title: mydocs

theme:
  - github.com/google/docsy

# --- Ajustes para URLs ---
canonifyURLs: true      # Reescribe URLs internas usando baseURL
relativeURLs: false     # Queremos rutas absolutas relativas a baseURL

# Language settings
contentDir: content/en
defaultContentLanguage: en
defaultContentLanguageInSubdir: false
# Useful when translating.
enableMissingTranslationPlaceholders: true

# Language configuration
languages:
  en:
    languageName: English
    title: mydocs
    weight: 1
    contentDir: content/en
    params:
      description: My personal notes site
  es:
    languageName: Español
    title: mis docs
    weight: 2
    contentDir: content/es
    params:
      description: Mi sitio de notas personales

enableRobotsTXT: true

# Will give values to .Lastmod etc.
enableGitInfo: true

# 🎯 SOLUCIÓN: Deshabilitar taxonomías completamente
disableKinds: [taxonomy, taxonomyTerm]

# 🎯 ALTERNATIVA: Comentar/eliminar esta sección si usas disableKinds
# taxonomies:
#   tag: tags
#   category: categories

# Highlighting config
pygmentsCodeFences: true
pygmentsUseClasses: false
pygmentsUseClassic: false
pygmentsStyle: tango

# Configure how URLs look like per section.
permalinks:
  blog: /:section/:year/:month/:day/:slug/

# Image processing configuration.
imaging:
  resampleFilter: CatmullRom
  quality: 75
  anchor: smart

markup:
  goldmark:
    parser:
      attribute:
        block: true
    renderer:
      unsafe: true
  highlight:
    style: tango
    guessSyntax: true

# Parámetros de contenido para búsqueda
frontmatter:
  date: [date, publishDate, lastmod]

# Comment out if you don't want the "print entire section" link enabled.
outputs:
  home: [HTML, RSS, JSON]
  section: [HTML, RSS]

params:
  description: My site personal notes

  # Configuración multiidioma
  language_alternatives:
    - languageName: English
      languageCode: en
    - languageName: Español
      languageCode: es

  # 🎯 Configuración de taxonomía (opcional si usas disableKinds)
  taxonomy:
    taxonomyCloud: []
    taxonomyCloudTitle: []
    taxonomyPageHeader: []

  version_menu: Releases
  archived_version: false
  version: 0.0

  # Enable syntax highlighting and copy buttons on code blocks with Prism
  prism_syntax_highlighting: false
  
  copyright: "dz | All rights reserved"

  # Enable Lunr.js offline search
  offlineSearch: true
  
  # User interface configuration
  ui:    
    breadcrumb_disable: false
    navbar_logo: true
    navbar_search_disable: true
    sidebar_search_disable: false
    navbar_disable_title: true
    navbar_translucent_over_cover_disable: false
    sidebar_menu_compact: true

    feedback:
      enable: false
      'yes': >-
        Glad to hear it! Please <a href="https://github.com/dozamo/dozamo.github.com/issues/new">tell us how we can improve</a>.
      'no': >-
        Sorry to hear that. Please <a href="https://github.com/dozamo/dozamo.github.com/issues/new">tell us how we can improve</a>.

    readingtime:
      enable: false

  links:
    developer:
      - name: GitHub dozamo
        url: https://github.com/dozamo/
        icon: fab fa-github
        desc: dz

module:
  hugoVersion:
    extended: true
    min: 0.146.0
  imports:
    - path: github.com/google/docsy
      disable: false

# Menú principal
menu:
  main:
    - name: "About"
      url: "/about/"
      weight: 20
      pre: "<i class='fas fa-book'></i>"
    - name: "LFCS Notes"
      url: "/lfcs/"
      weight: 40
      pre: "<i class='fa-brands fa-linux'></i>"
    - name: "AI Notes"
      url: "/ai-notes/"
      weight: 50
      pre: "<i class='fa-solid fa-brain'></i>"
